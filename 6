
#include <stdio.h>

int main() {
    int n, bt[20], rem[20], pr[20], tat[20], wt[20];
    int i, t = 0, done = 0, best;
    int totalWT = 0, totalTAT = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter burst time and priority of P%d: ", i + 1);
        scanf("%d%d", &bt[i], &pr[i]);
        rem[i] = bt[i];
    }

    while (done < n) {
        best = -1;

        for (i = 0; i < n; i++) {
            if (rem[i] > 0 &&
                (best == -1 || pr[i] < pr[best]))
                best = i;
        }

        if (best == -1)
            break;

        rem[best]--;
        t++;

        if (rem[best] == 0) {
            done++;
            tat[best] = t;
            wt[best] = tat[best] - bt[best];
        }
    }

    printf("\nProcess\tBT\tPriority\tWT\tTAT\n");

    for (i = 0; i < n; i++) {
        totalWT += wt[i];
        totalTAT += tat[i];

        printf("P%d\t%d\t%d\t\t%d\t%d\n",
               i + 1, bt[i], pr[i], wt[i], tat[i]);
    }

    printf("Average WT = %.2f\n", (float)totalWT / n);
    printf("Average TAT = %.2f\n", (float)totalTAT / n);

    return 0;
}
